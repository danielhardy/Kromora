<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KromoraAllowLibraryOverride</key>
	<string>$(KROMORA_ALLOW_LIBRARY_OVERRIDE)</string>
	<key>KromoraGitCommit</key>
	<string>$(KROMORA_GIT_COMMIT)</string>
	<!-- Xcode 27 has no INFOPLIST_KEY_ setting that emits NSHighResolutionCapable, so it stays here. -->
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Kromora Library Package</string>
			<key>UTTypeIdentifier</key>
			<string>com.kromora.kromoralibrary</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kromoralibrary</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-kromora-library</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Kromora Original and Settings Bundle</string>
			<key>UTTypeIdentifier</key>
			<string>com.kromora.original-settings-bundle</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kromora-original</string>
				</array>
				<key>public.mime-type</key>
				<string>application/x-kromora-original</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
