<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- MountedMediaVolumeProvider and MediaVolume.scanMountedVolume read camera-card images. -->
	<key>com.apple.security.files.removable-media.read-only</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- KromoraStorage.defaultPortableLibraryPackageURL and app-owned exports/Looks use Pictures. -->
	<key>com.apple.security.assets.pictures.read-write</key>
	<true/>
</dict>
</plist>
